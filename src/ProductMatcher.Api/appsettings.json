{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Matcher": "Host=localhost;Port=5434;Database=product_matcher;Username=matcher;Password=matcher"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Embeddings": {
    "Provider": "OpenAI",
    "Endpoint": "http://localhost:5080/v1",
    "Model": "text-embedding-3-small",
    "BackgroundJob": true,
    "Cache": {
      "Enabled": true,
      "MemoryEntries": 10000
    }
  },
  "Reranking": {
    "PhraseBoost": 0.25,
    "ProductBoost": 0.05,
    "SaturationCount": 3,
    "CandidatePoolMultiplier": 4
  },
  "Confidence": {
    "Default": {
      "AutoAcceptScore": 0.6,
      "MinMargin": 0.05,
      "ReviewScore": 0.3
    },
    "Models": {
      "local-hashing-v1": {
        "AutoAcceptScore": 0.4,
        "MinMargin": 0.1,
        "ReviewScore": 0.225
      },
      "text-embedding-3-small": {
        "AutoAcceptScore": 0.4,
        "MinMargin": 0.02,
        "ReviewScore": 0.275
      },
      "nomic-embed-text": {
        "AutoAcceptScore": 0.65,
        "MinMargin": 0.0,
        "ReviewScore": 0.575
      },
      "bge-m3": {
        "AutoAcceptScore": 0.6,
        "MinMargin": 0.0,
        "ReviewScore": 0.4
      }
    }
  }
}
